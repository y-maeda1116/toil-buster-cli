{
  "name": "toil-buster-cli",
  "version": "0.1.0",
  "description": "Toil Buster CLI - CloudWatch Logs error extraction & statistics for SREs",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "cloudwatch",
    "logs",
    "sre",
    "toil",
    "cli",
    "error-analysis"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsup --clean && tsgo --emitDeclarationOnly --declaration --outDir dist --noEmit false",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**",
    "format:check": "prettier --check src/**",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.1.0",
    "eslint-plugin-security": "^4.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1146.0",
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "zod": "^4.3.6"
  },
  "bin": {
    "tb": "bin/tb.js"
  },
  "files": [
    "bin",
    "dist"
  ]
}
