{
  "name": "toil-buster-cli",
  "version": "0.1.0",
  "description": "Toil Buster CLI - CloudWatch Logs error extraction & statistics for SREs",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "cloudwatch",
    "logs",
    "sre",
    "toil",
    "cli",
    "error-analysis"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsup --clean && tsc --emitDeclarationOnly --declaration --outDir dist --noEmit false",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**",
    "format:check": "prettier --check src/**",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-plugin-security": "^4.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1149.0",
    "chalk": "^6.0.1",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "zod": "^4.6.7"
  },
  "bin": {
    "tb": "bin/tb.js"
  },
  "files": [
    "bin",
    "dist"
  ]
}
